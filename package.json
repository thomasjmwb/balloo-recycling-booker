{
  "name": "balloo-recycling-booker",
  "version": "1.0.0",
  "description": "PWA for booking recycling centre appointments",
  "type": "module",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev": "tsx scripts/dev.ts",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "start": "cd server && npm start",
    "discover": "cd scripts && tsx discover.ts",
    "debug:slots": "cd scripts && tsx debug-slots-capture.ts",
    "test:step": "cd scripts && tsx test-steps.ts",
    "lint": "cd server && npm run lint",
    "test:health": "cd server && npm run test:health",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\"",
    "test:preflight": "vitest run scripts/__tests__/ --reporter=verbose"
  },
  "keywords": [
    "recycling",
    "booking",
    "pwa",
    "puppeteer",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5",
    "prettier": "^3.3.0",
    "puppeteer": "^23.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.1"
  }
}

# Required
BOOKING_URL=https://selfservice.ardsandnorthdown.gov.uk/renderform.aspx?t=1&k=D184453EA968B031716937950C1C181E254C0F0C

# Server config
# PORT=3000 is the dev default. The production NSSM service overrides this to 3100
# via AppEnvironmentExtra; Caddy reverse-proxies recycling.local.home -> 127.0.0.1:3100.
# See docs/deployment.md for details.
PORT=3000
HEADLESS=true
DEBUG_HTML_LOGS=true

# Step 1: Your details
EMAIL=your@email.com
BLUE_BADGE_HOLDER=false
RESIDENTIAL_OR_CHARITY=Residential
WHO_BRINGS_WASTE=I am bringing my own household waste
POSTCODE=BT19 1AA
ADDRESS_VALUE=
HIRING_VAN=false

# Step 2: Default waste types (comma-separated field IDs)
WASTE_DEFAULTS=FF34,FF48,FF33,FF50

# Step 3: Vehicle
VEHICLE_REGISTRATION=ABC 123
TRANSPORT_TYPE=Car
TRAILER_TYPE=No Trailer
SITE=Balloo

# API URLs (typically don't need to change)
ADDRESS_LOOKUP_URL=https://selfservice.ardsandnorthdown.gov.uk/core/addresslookup
SLOTS_API_URL=https://selfservice.ardsandnorthdown.gov.uk/renderform/getavailabletimeslots
REFRESH_API_URL=https://selfservice.ardsandnorthdown.gov.uk/ajax/refresh

# Router DNS auto-fix (production only)
# When enabled, on startup the server checks that ROUTER_HOST resolves
# LOCAL_HOSTNAME to LOCAL_HOST_IP. If not, it SSHes to the router and
# re-applies the dnsmasq forwarder. See docs/router-dns-setup.md.
# Off by default so dev/test runs don't try to talk to a router.
ROUTER_DNS_AUTOFIX=false
ROUTER_HOST=192.168.50.1
ROUTER_SSH_PORT=1025
ROUTER_SSH_USER=admin
# Absolute path to the SSH private key. Leave empty to use ssh.exe's default
# (~/.ssh/id_*). When the service runs as LocalSystem the user profile is the
# system profile, so an explicit path to a key the SYSTEM account can read is
# usually required in production.
ROUTER_SSH_KEY=
LOCAL_HOSTNAME=recycling.local.home
LOCAL_HOST_IP=192.168.50.94
